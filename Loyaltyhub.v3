kground: #D4D3CE; border-radius: 9999px; }\n  .fds-scroll::-webkit-scrollbar-track { background: transparent; }\n  @media (max-width: 960px) { .hub-grid { grid-template-columns: 1fr !important; } }\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<header style=\"position:sticky;top:0;z-index:40;background:#fff;border-bottom:1px solid #E6E5E0\">\n  <div style=\"max-width:1280px;margin:0 auto;padding:13px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px\">\n    <div style=\"display:flex;align-items:center;gap:14px;min-width:0\">\n      <img src=\"d14795d1-d070-48c3-9c9c-285e7dcba9c6\" alt=\"Finder\" style=\"height:23px;display:block\">\n      <span style=\"border-left:1px solid #E6E5E0;padding-left:14px;font-size:14px;font-weight:500;color:#74736E\">Customer Hub<\u002Fspan>\n    <\u002Fdiv>\n    <div style=\"display:flex;align-items:center;gap:14px\">\n      <div style=\"display:flex;align-items:center;gap:7px;background:#F5F4EF;border:1px solid #E6E5E0;color:#41403B;padding:7px 13px;border-radius:9999px;font-size:12px;font-weight:600\">\n        <i class=\"ph ph-clock\" style=\"font-size:14px;color:#74736E\"><\u002Fi><span>{{ today }}<\u002Fspan>\n      <\u002Fdiv>\n      <div style=\"width:38px;height:38px;border-radius:9999px;background:#232320;color:#fff;display:flex;align-items:center;justify-content:center;font-family:var(--ff-display);font-weight:800;font-size:15px\">{{ initial }}<\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n  <div style=\"border-top:1px solid #EFEEE9\">\n    <nav style=\"max-width:1280px;margin:0 auto;padding:0 24px;display:flex;align-items:center;gap:26px;font-size:14px;font-weight:500;overflow-x:auto;white-space:nowrap\">\n      <a href=\"#\" style=\"display:flex;align-items:center;gap:8px;padding:15px 0;border-bottom:3px solid transparent;color:#74736E;text-decoration:none\"><i class=\"ph ph-squares-four\" style=\"font-size:17px\"><\u002Fi>Dashboard<\u002Fa>\n      <a href=\"#\" style=\"display:flex;align-items:center;gap:8px;padding:15px 0;border-bottom:3px solid #0C7A4A;color:#0C7A4A;font-weight:700;text-decoration:none;position:relative\"><i class=\"ph ph-car-profile\" style=\"font-size:17px\"><\u002Fi>EV Giveaway\n        <span style=\"position:absolute;top:12px;right:-9px;width:7px;height:7px;border-radius:9999px;background:#DB2420\"><\u002Fspan>\n      <\u002Fa>\n      <a href=\"#\" style=\"display:flex;align-items:center;gap:8px;padding:15px 0;border-bottom:3px solid transparent;color:#74736E;text-decoration:none\"><i class=\"ph ph-gift\" style=\"font-size:17px\"><\u002Fi>Rewards<\u002Fa>\n      <a href=\"#\" style=\"display:flex;align-items:center;gap:8px;padding:15px 0;border-bottom:3px solid transparent;color:#74736E;text-decoration:none\"><i class=\"ph ph-stack\" style=\"font-size:17px\"><\u002Fi>My Products\n        <span style=\"background:#FFD23B;color:#232320;font-size:10px;font-weight:800;letter-spacing:.04em;padding:2px 6px;border-radius:6px;line-height:1\">NEW<\u002Fspan>\n      <\u002Fa>\n      <a href=\"#\" style=\"display:flex;align-items:center;gap:8px;padding:15px 0;border-bottom:3px solid transparent;color:#74736E;text-decoration:none\"><i class=\"ph ph-gauge\" style=\"font-size:17px\"><\u002Fi>Credit score<\u002Fa>\n      <a href=\"#\" style=\"display:flex;align-items:center;gap:8px;padding:15px 0;border-bottom:3px solid transparent;color:#74736E;text-decoration:none\"><i class=\"ph ph-user-circle\" style=\"font-size:17px\"><\u002Fi>Settings<\u002Fa>\n    <\u002Fnav>\n  <\u002Fdiv>\n<\u002Fheader>\n\n<div style=\"max-width:1280px;margin:0 auto;padding:30px 24px 6px;display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap\">\n  <div style=\"min-width:280px\">\n    <h1 style=\"font-family:var(--ff-display);font-weight:700;font-size:34px;color:#232320;margin:0;letter-spacing:-.01em\">Hey {{ userName }}<\u002Fh1>\n    <p style=\"margin:8px 0 0;font-size:14px;color:#74736E;max-width:600px;line-height:1.55;text-wrap:pretty\">Complete actions to earn entries into the EV Giveaway — win a brand-new <strong style=\"color:#41403B;font-weight:700\">Geely EX5<\u002Fstrong>.<br><strong style=\"color:#41403B;font-weight:700\">Finder Fridays<\u002Fstrong> tasks win the weekly cash draw and stack toward the Geely too.<\u002Fp>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<main class=\"hub-grid\" style=\"max-width:1280px;margin:0 auto;padding:18px 24px 56px;display:grid;grid-template-columns:1.55fr 1fr;gap:24px;align-items:start\">\n\n  <div>\n    <!-- EV EXCLUSIVE GROUP -->\n    <div style=\"display:flex;align-items:center;gap:13px;margin:2px 0 14px;background:#159A52;border-radius:14px;padding:14px 18px;color:#fff;position:relative;overflow:hidden;z-index:0\">\n      <img src=\"65ccda1f-d04e-42c8-a2d5-34777c752c64\" alt=\"Finder\" style=\"width:30px;height:30px;flex-shrink:0\">\n      <div style=\"flex:1;min-width:0\">\n        <div style=\"font-family:var(--ff-display);font-weight:700;font-size:16px;color:#fff\">EV Giveaway exclusive<\u002Fdiv>\n        <div style=\"font-size:12px;color:rgba(255,255,255,.85)\">Big-ticket actions — entries count toward the car only<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <sc-for list=\"{{ evTasksView }}\" as=\"t\" hint-placeholder-count=\"3\">\n      <div style=\"background:#F5FBF7;border:1px solid #CFE8D9;border-radius:16px;padding:18px 20px;display:flex;align-items:center;gap:16px;margin-bottom:12px;transition:border-color .15s ease-out,transform .15s ease-out\" style-hover=\"border-color:#9FD5B5;transform:translateY(-2px)\">\n        <div style=\"flex:1;min-width:0;display:flex;flex-direction:column;gap:5px\">\n          <span style=\"align-self:flex-start;display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;padding:3px 8px;border-radius:9999px;background:{{ t.tagBg }};color:{{ t.tagColor }}\"><i class=\"ph ph-car-profile\" style=\"font-size:12px\"><\u002Fi>{{ t.tagText }}<\u002Fspan>\n          <div style=\"font-family:var(--ff-display);font-weight:700;font-size:16px;color:#232320;line-height:1.2\">{{ t.title }}<\u002Fdiv>\n          <div style=\"font-size:13px;color:#74736E;line-height:1.45\">{{ t.desc }}<\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:flex;flex-direction:column;align-items:flex-end;gap:11px;flex-shrink:0\">\n          <span style=\"display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:800;padding:5px 11px;border-radius:9999px;background:{{ t.entryBg }};color:{{ t.entryColor }};border:1px solid {{ t.entryBorder }}\"><i class=\"ph ph-plus-circle\" style=\"font-size:12px\"><\u002Fi>{{ t.entriesLabel }}<\u002Fspan>\n          <button sc-camel-on-click=\"{{ t.onDo }}\" disabled=\"{{ t.btnDisabled }}\" style=\"font-family:var(--ff-body);font-weight:500;font-size:14px;border:none;cursor:pointer;border-radius:12px;padding:9px 16px;min-width:130px;color:#fff;background:{{ t.btnBg }};transition:background .15s ease-out\">{{ t.btnLabel }}<\u002Fbutton>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsc-for>\n\n    <!-- FINDER FRIDAYS GROUP -->\n    <div style=\"display:flex;align-items:center;gap:13px;margin:26px 0 14px;background:#FFD23B;border-radius:14px;padding:14px 18px;color:#232320;position:relative;overflow:hidden\">\n      <img src=\"65ccda1f-d04e-42c8-a2d5-34777c752c64\" alt=\"Finder\" style=\"width:30px;height:30px;flex-shrink:0\">\n      <div style=\"flex:1;min-width:0\">\n        <div style=\"font-family:var(--ff-display);font-weight:700;font-size:16px;color:#232320\">Finder Fridays<\u002Fdiv>\n        <div style=\"font-size:12px;color:#6B5200\">Quick actions — win the weekly draw and add EV entries too<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <!-- $200 WEEKLY DRAW -->\n    <div style=\"background:#FFF6D6;border:1px solid #F4E2A0;border-radius:14px;padding:13px 16px;margin:0 0 12px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap\">\n      <div style=\"min-width:0\">\n        <span style=\"font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#8A6D00\">Finder Fridays · this week<\u002Fspan>\n        <div style=\"display:flex;align-items:baseline;gap:10px;margin-top:3px;flex-wrap:wrap\">\n          <div style=\"font-family:var(--ff-display);font-weight:700;font-size:18px;color:#232320\">$200 cash draw<\u002Fdiv>\n          <span style=\"display:inline-flex;align-items:center;gap:5px;font-family:var(--ff-mono);font-weight:700;font-size:13px;color:#8A6D00\"><i class=\"ph ph-clock\" style=\"font-size:12px\"><\u002Fi>{{ cdD }}d {{ cdH }}h {{ cdM }}m {{ cdS }}s<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"display:flex;align-items:center;gap:14px;flex-shrink:0\">\n        <div style=\"text-align:right\">\n          <div style=\"font-family:var(--ff-display);font-weight:900;font-style:italic;font-size:22px;color:#232320;line-height:1\">{{ ffDisplay }}<\u002Fdiv>\n          <div style=\"font-size:10px;color:#8A6D00;font-weight:600;margin-top:2px\">your entries<\u002Fdiv>\n        <\u002Fdiv>\n        <button sc-camel-on-click=\"{{ claimFree }}\" disabled=\"{{ claimDisabled }}\" style=\"font-family:var(--ff-body);font-weight:500;font-size:14px;border:none;cursor:pointer;border-radius:12px;padding:10px 16px;color:#fff;background:{{ claimBg }};white-space:nowrap;transition:background .15s ease-out\">{{ claimLabel }}<\u002Fbutton>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <sc-for list=\"{{ ffTasksView }}\" as=\"t\" hint-placeholder-count=\"6\">\n      <div style=\"background:#fff;border:1px solid #E6E5E0;border-radius:16px;padding:18px 20px;display:flex;align-items:center;gap:16px;margin-bottom:12px;transition:border-color .15s ease-out,transform .15s ease-out\" style-hover=\"border-color:#F0DFA0;transform:translateY(-2px)\">\n        <div style=\"flex:1;min-width:0;display:flex;flex-direction:column;gap:5px\">\n          <span style=\"align-self:flex-start;font-size:10px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;padding:3px 8px;border-radius:9999px;background:{{ t.tagBg }};color:{{ t.tagColor }}\">{{ t.tagText }}<\u002Fspan>\n          <div style=\"font-family:var(--ff-display);font-weight:700;font-size:16px;color:#232320;line-height:1.2\">{{ t.title }}<\u002Fdiv>\n          <div style=\"font-size:13px;color:#74736E;line-height:1.45\">{{ t.desc }}<\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:flex;flex-direction:column;align-items:flex-end;gap:11px;flex-shrink:0\">\n          <span style=\"display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:800;padding:5px 11px;border-radius:9999px;background:{{ t.entryBg }};color:{{ t.entryColor }};border:1px solid {{ t.entryBorder }}\"><i class=\"ph ph-plus-circle\" style=\"font-size:12px\"><\u002Fi>{{ t.entriesLabel }}<\u002Fspan>\n          <button sc-camel-on-click=\"{{ t.onDo }}\" disabled=\"{{ t.btnDisabled }}\" style=\"font-family:var(--ff-body);font-weight:500;font-size:14px;border:none;cursor:pointer;border-radius:12px;padding:9px 16px;min-width:130px;color:#fff;background:{{ t.btnBg }};transition:background .15s ease-out\">{{ t.btnLabel }}<\u002Fbutton>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsc-for>\n  <\u002Fdiv>\n\n  <!-- RIGHT: TRACKING -->\n  <div>\n    <!-- EV SCOREBOARD -->\n    <div ref=\"{{ evCardRef }}\" style=\"background:#159A52;border-radius:16px;padding:22px;color:#fff;position:relative;overflow:hidden;z-index:0\">\n      <div style=\"margin:-22px -22px 16px;position:relative\">\n        <img src=\"faf669dd-60eb-477f-9d98-24fd80bf90ae\" alt=\"Geely EX5 electric SUV\" style=\"width:100%;height:176px;object-fit:cover;display:block\">\n        <span style=\"position:absolute;top:14px;left:14px;display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;background:rgba(11,42,26,.55);color:#fff;backdrop-filter:saturate(160%) blur(4px);padding:5px 11px;border-radius:9999px\">Grand prize<\u002Fspan>\n      <\u002Fdiv>\n      <div style=\"min-width:0\">\n        <div style=\"display:flex;align-items:center;gap:9px\">\n          <img src=\"65ccda1f-d04e-42c8-a2d5-34777c752c64\" alt=\"Finder\" style=\"width:26px;height:26px;flex-shrink:0\">\n          <div style=\"font-family:var(--ff-display);font-weight:700;font-size:21px;line-height:1.15\">EV Giveaway<\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"font-size:12px;color:rgba(255,255,255,.82);margin-top:3px\">Win a brand-new electric car — the Geely EX5<\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"display:flex;align-items:baseline;gap:9px;margin-top:20px\">\n        <span style=\"font-family:var(--ff-display);font-weight:900;font-style:italic;font-size:50px;line-height:1;letter-spacing:-.03em\">{{ evDisplay }}<\u002Fspan>\n        <span style=\"font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.04em;color:rgba(255,255,255,.85)\">entries<\u002Fspan>\n      <\u002Fdiv>\n      <div style=\"margin-top:16px\">\n        <div style=\"display:flex;justify-content:flex-end;font-size:11px;font-weight:700;color:rgba(255,255,255,.85);margin-bottom:7px\"><span>{{ evRatio }}<\u002Fspan><\u002Fdiv>\n        <div style=\"height:10px;background:rgba(255,255,255,.22);border-radius:9999px;overflow:hidden\"><div style=\"height:100%;background:#ffffff;border-radius:9999px;width:{{ evPct }};transition:width .6s cubic-bezier(.16,1,.3,1)\"><\u002Fdiv><\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"font-size:11px;color:rgba(255,255,255,.78);margin-top:12px;line-height:1.45\">Every action — Finder Fridays included — adds entries here.<\u002Fdiv>\n      <div style=\"margin-top:18px;border-top:1px solid rgba(255,255,255,.18);padding-top:16px\">\n        <div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px\">\n          <div style=\"font-family:var(--ff-display);font-weight:700;font-size:15px;color:#fff\">Top entrants<\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:flex;flex-direction:column;gap:7px\">\n          <sc-for list=\"{{ leaderView }}\" as=\"l\" hint-placeholder-count=\"10\">\n            <div style=\"display:flex;align-items:center;gap:11px;border:1px solid {{ l.rowBorder }};background:{{ l.rowBg }};border-radius:12px;padding:8px 11px\">\n              <div style=\"flex:1;min-width:0\">\n                <div style=\"font-family:var(--ff-display);font-weight:700;font-size:13px;color:{{ l.nameColor }};line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">{{ l.name }}<\u002Fdiv>\n                <div style=\"font-size:10px;font-weight:600;color:{{ l.subColor }}\">{{ l.suburb }}<\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"text-align:right;flex-shrink:0\">\n                <div style=\"font-family:var(--ff-display);font-weight:900;font-style:italic;font-size:16px;color:{{ l.entriesColor }};line-height:1\">{{ l.entriesLabel }}<\u002Fdiv>\n                <div style=\"font-size:8px;text-transform:uppercase;letter-spacing:.07em;font-weight:800;color:{{ l.unitColor }}\">entries<\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n  <\u002Fdiv>\n<\u002Fmain>\n\n<sc-if value=\"{{ showHelp }}\" hint-placeholder-val=\"{{ false }}\">\n  <div sc-camel-on-click=\"{{ closeHelp }}\" style=\"position:fixed;inset:0;background:rgba(35,35,32,.55);backdrop-filter:saturate(180%) blur(4px);display:flex;align-items:center;justify-content:center;padding:24px;z-index:100;animation:fdsFade .2s ease-out\">\n    <div sc-camel-on-click=\"{{ stopProp }}\" style=\"background:#fff;border-radius:20px;max-width:460px;width:100%;padding:28px;border:1px solid #E6E5E0;box-shadow:0 20px 40px rgba(35,35,32,.12)\">\n      <div style=\"font-family:var(--ff-display);font-weight:700;font-size:22px;color:#232320\">How entries work<\u002Fdiv>\n      <p style=\"font-size:14px;color:#41403B;line-height:1.55;margin:10px 0 18px\">Two draws, one list of actions. The colour tells you which draw an action feeds.<\u002Fp>\n      <div style=\"display:flex;align-items:flex-start;gap:12px;background:#E3F4EA;border:1px solid #B7E3C9;border-radius:14px;padding:14px;margin-bottom:12px\">\n        <span style=\"width:12px;height:12px;border-radius:9999px;background:#0C7A4A;flex-shrink:0;margin-top:3px\"><\u002Fspan>\n        <div><div style=\"font-family:var(--ff-display);font-weight:700;font-size:14px;color:#232320\">EV Giveaway exclusive<\u002Fdiv><div style=\"font-size:13px;color:#41403B;line-height:1.5;margin-top:2px\">High-value actions worth 500+ entries. These count toward the car only.<\u002Fdiv><\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"display:flex;align-items:flex-start;gap:12px;background:#FFF6D6;border:1px solid #F4E2A0;border-radius:14px;padding:14px;margin-bottom:20px\">\n        <span style=\"width:12px;height:12px;border-radius:9999px;background:#FFD23B;flex-shrink:0;margin-top:3px\"><\u002Fspan>\n        <div><div style=\"font-family:var(--ff-display);font-weight:700;font-size:14px;color:#232320\">Finder Fridays<\u002Fdiv><div style=\"font-size:13px;color:#41403B;line-height:1.5;margin-top:2px\">Quick weekly actions. They win the cash draw <strong>and<\u002Fstrong> add to your EV Giveaway total.<\u002Fdiv><\u002Fdiv>\n      <\u002Fdiv>\n      <button sc-camel-on-click=\"{{ closeHelp }}\" style=\"width:100%;font-family:var(--ff-body);font-weight:500;font-size:15px;border:none;cursor:pointer;border-radius:12px;padding:12px;color:#fff;background:#1D53FF;transition:background .15s ease-out\" style-hover=\"background:#0A41EE\">Got it<\u002Fbutton>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsc-if>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:1280,&quot;height&quot;:1040},&quot;userName&quot;:{&quot;editor&quot;:&quot;text&quot;,&quot;default&quot;:&quot;Jason&quot;,&quot;tsType&quot;:&quot;string&quot;},&quot;evGoal&quot;:{&quot;editor&quot;:&quot;int&quot;,&quot;default&quot;:5000,&quot;min&quot;:1000,&quot;max&quot;:20000,&quot;step&quot;:500,&quot;tsType&quot;:&quot;number&quot;},&quot;celebrate&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;}}\">\nclass Component extends DCLogic {\n  evCardRef = React.createRef();\n\n  evTasks = [\n    { id: 'credit',  icon: 'ph-file-arrow-up',  title: 'Upload credit score', desc: 'Check your score instantly and track changes over time.', entries: 500,  btn: 'Upload',       done: 'Uploaded',  cat: 'EV', badge: 'CS', vertical: 'Credit score', feedTitle: 'Credit score uploaded' },\n    { id: 'product', icon: 'ph-folder-plus',    title: 'Add a My Product',    desc: 'Save the products you use to track and manage them in one place.', entries: 500,  btn: 'Add product',  done: 'Added',     cat: 'EV', badge: 'MP', vertical: 'My Products',  feedTitle: 'My Product added' },\n    { id: 'reward',  icon: 'ph-shopping-cart',  title: 'Purchase a reward',   desc: 'Claim a Finder Reward from participating offers.', entries: 1000, btn: 'Purchase',     done: 'Purchased', cat: 'EV', badge: 'RW', vertical: 'Rewards',      feedTitle: 'Finder Reward purchased' },\n  ];\n\n  ffTasks = [\n    { id: 'ff-reward',   icon: 'ph-shopping-cart',   title: 'Purchase a reward',    desc: 'Claim a Finder Reward from participating offers this week.', entries: 1000, btn: 'Purchase', done: 'Purchased', cat: 'FF', badge: 'RW', vertical: 'Rewards', feedTitle: 'Finder Reward purchased' },\n    { id: 'refer',       icon: 'ph-user-plus',       title: 'Refer a friend',       desc: 'Invite friends to compare on Finder and earn bonus entries.', entries: 50, btn: 'Refer friend', done: 'Referred', cat: 'FF', badge: 'RF', vertical: 'Referrals', feedTitle: 'Friend referral validated' },\n    { id: 'quiz-cc',     icon: 'ph-graduation-cap',  title: 'Credit cards quiz',    desc: 'Balance transfers, interest rates and rewards programs.', entries: 10, btn: 'Take quiz', done: 'Solved', cat: 'FF', badge: 'CC', vertical: 'Quiz', feedTitle: 'Credit cards quiz' },\n    { id: 'quiz-home',   icon: 'ph-graduation-cap',  title: 'Home insurance quiz',  desc: 'Building and contents cover and what\\u2019s included.', entries: 10, btn: 'Take quiz', done: 'Solved', cat: 'FF', badge: 'HI', vertical: 'Quiz', feedTitle: 'Home insurance quiz' },\n    { id: 'quiz-mobile', icon: 'ph-graduation-cap',  title: 'Mobile plans quiz',    desc: 'Compare plans on data, price and overall value.', entries: 10, btn: 'Take quiz', done: 'Solved', cat: 'FF', badge: 'MB', vertical: 'Quiz', feedTitle: 'Mobile plans quiz' },\n    { id: 'quiz-health', icon: 'ph-graduation-cap',  title: 'Health insurance quiz',desc: 'Hospital cover, extras and combined policies.', entries: 10, btn: 'Take quiz', done: 'Solved', cat: 'FF', badge: 'HE', vertical: 'Quiz', feedTitle: 'Health insurance quiz' },\n  ];\n\n  others = [\n    { name: 'Mia R.',   suburb: 'Bondi, NSW',        entries: 3240 },\n    { name: 'Noah B.',  suburb: 'Newtown, NSW',      entries: 2890 },\n    { name: 'Tom K.',   suburb: 'Fitzroy, VIC',      entries: 2680 },\n    { name: 'Priya S.', suburb: 'West End, QLD',     entries: 2450 },\n    { name: 'Ella M.',  suburb: 'Subiaco, WA',       entries: 1780 },\n    { name: 'Liam W.',  suburb: 'Fremantle, WA',     entries: 1520 },\n    { name: 'Jack T.',  suburb: 'Carlton, VIC',      entries: 1180 },\n    { name: 'Ava C.',   suburb: 'Glenelg, SA',       entries: 940 },\n    { name: 'Zoe H.',   suburb: 'Manly, NSW',        entries: 620 },\n  ];\n\n  state = {\n    evEntries: 2011,\n    evShown: 2011,\n    ffEntries: 11,\n    ffShown: 11,\n    taskStatus: {},\n    claimDisabled: false,\n    feed: [\n      { id: 'i1', cat: 'EV', badge: 'CS', vertical: 'Credit score', title: 'Credit score uploaded', entries: 500,  date: '24 Jun 2026' },\n      { id: 'i2', cat: 'EV', badge: 'MP', vertical: 'My Products',  title: 'My Product added',      entries: 500,  date: '24 Jun 2026' },\n      { id: 'i3', cat: 'FF', badge: 'FF', vertical: 'Finder Fridays', title: 'Free entry claimed',  entries: 1,    date: '23 Jun 2026' },\n      { id: 'i4', cat: 'FF', badge: 'CC', vertical: 'Quiz', title: 'Credit cards quiz',             entries: 10,   date: '23 Jun 2026' },\n      { id: 'i5', cat: 'EV', badge: 'RW', vertical: 'Rewards', title: 'Dodo NBN reward purchased',  entries: 1000, date: '20 Jun 2026' },\n    ],\n    cd: { d: '00', h: '00', m: '00', s: '00' },\n    showHelp: false,\n  };\n\n  componentDidMount() {\n    this.tick();\n    this._timer = setInterval(() => this.tick(), 1000);\n  }\n  componentWillUnmount() { clearInterval(this._timer); }\n\n  fmt(n) { return Number(n).toLocaleString('en-AU'); }\n\n  sydParts() {\n    const p = new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Sydney', weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' }).formatToParts(new Date());\n    const g = t => (p.find(x => x.type === t) || {}).value;\n    return { wd: g('weekday'), day: g('day'), mon: g('month'), year: g('year') };\n  }\n  sydToday(withWeekday) {\n    const p = this.sydParts();\n    return (withWeekday ? p.wd + ', ' : '') + p.day + ' ' + p.mon + ' ' + p.year;\n  }\n\n  tick() {\n    const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Australia/Sydney' }));\n    const t = new Date(now);\n    t.setHours(15, 0, 0, 0);\n    let diff = (5 - now.getDay() + 7) % 7;\n    if (diff === 0 && now.getTime() > t.getTime()) diff = 7;\n    t.setDate(now.getDate() + diff);\n    let ms = t.getTime() - now.getTime();\n    if (ms < 0) ms = 0;\n    const p = x => String(x).padStart(2, '0');\n    this.setState({ cd: {\n      d: p(Math.floor(ms / 86400000)),\n      h: p(Math.floor((ms % 86400000) / 3600000)),\n      m: p(Math.floor((ms % 3600000) / 60000)),\n      s: p(Math.floor((ms % 60000) / 1000)),\n    }});\n  }\n\n  tween(key, from, to) {\n    const dur = 650, start = performance.now();\n    const step = (now) => {\n      const p = Math.min((now - start) / dur, 1);\n      const e = 1 - Math.pow(1 - p, 3);\n      this.setState({ [key]: Math.round(from + (to - from) * e) });\n      if (p < 1) requestAnimationFrame(step);\n    };\n    requestAnimationFrame(step);\n  }\n\n  float(text) {\n    if (!(this.props.celebrate ?? true)) return;\n    const host = this.evCardRef.current;\n    if (!host) return;\n    const el = document.createElement('span');\n    el.textContent = text;\n    el.setAttribute('style', 'position:absolute;right:26px;top:96px;font-family:var(--ff-display);font-weight:900;font-style:italic;font-size:26px;color:#ffffff;pointer-events:none;animation:fdsFloat 1.15s cubic-bezier(.16,1,.3,1) forwards;z-index:6');\n    host.appendChild(el);\n    setTimeout(() => el.remove(), 1200);\n  }\n\n  doTask(t) {\n    if (this.state.taskStatus[t.id] === 'done') return;\n    const ev = t.cat === 'EV';\n    const newEv = this.state.evEntries + t.entries;\n    const newFf = this.state.ffEntries + (ev ? 0 : t.entries);\n    const item = { id: 'f' + Date.now(), cat: t.cat, badge: t.badge, vertical: t.vertical, title: t.feedTitle, entries: t.entries, date: this.sydToday(false) };\n    const fromEv = this.state.evShown, fromFf = this.state.ffShown;\n    this.setState(s => ({ evEntries: newEv, ffEntries: newFf, feed: [item, ...s.feed], taskStatus: { ...s.taskStatus, [t.id]: 'done' } }));\n    this.tween('evShown', fromEv, newEv);\n    if (!ev) this.tween('ffShown', fromFf, newFf);\n    this.float('+' + this.fmt(t.entries));\n    setTimeout(() => this.setState(s => {\n      const ts = { ...s.taskStatus };\n      delete ts[t.id];\n      return { taskStatus: ts };\n    }), 2200);\n  }\n\n  claimFree() {\n    if (this.state.claimDisabled) return;\n    const newEv = this.state.evEntries + 1, newFf = this.state.ffEntries + 1;\n    const item = { id: 'f' + Date.now(), cat: 'FF', badge: 'FF', vertical: 'Finder Fridays', title: 'Free entry claimed', entries: 1, date: this.sydToday(false) };\n    const fromEv = this.state.evShown, fromFf = this.state.ffShown;\n    this.setState(s => ({ evEntries: newEv, ffEntries: newFf, feed: [item, ...s.feed], claimDisabled: true }));\n    this.tween('evShown', fromEv, newEv);\n    this.tween('ffShown', fromFf, newFf);\n    this.float('+1');\n  }\n\n  viewTask(t) {\n    const ev = t.cat === 'EV';\n    const isDone = this.state.taskStatus[t.id] === 'done';\n    return {\n      ...t,\n      tileBg: ev ? '#E3F4EA' : '#FFF1C9',\n      tileColor: ev ? '#0C7A4A' : '#9A7B12',\n      tagText: ev ? 'EV exclusive' : 'Finder Fridays',\n      tagBg: ev ? '#E3F4EA' : '#FFF1C9',\n      tagColor: ev ? '#0C7A4A' : '#7A5C00',\n      entriesLabel: this.fmt(t.entries) + ' entries',\n      entryBg: ev ? '#E3F4EA' : '#FFF1C9',\n      entryColor: ev ? '#0C7A4A' : '#7A5C00',\n      entryBorder: ev ? '#B7E3C9' : '#F0DFA0',\n      btnLabel: isDone ? t.done : t.btn,\n      btnDisabled: isDone,\n      btnBg: isDone ? '#007828' : '#1D53FF',\n      onDo: () => this.doTask(t),\n    };\n  }\n\n  viewLeader(l, rank) {\n    const you = !!l.you;\n    const gold = rank === 1;\n    return {\n      ...l,\n      rank,\n      initial: l.name.trim().charAt(0).toUpperCase(),\n      entriesLabel: this.fmt(l.entries),\n      rowBg: you ? '#EAFBF1' : 'rgba(0,0,0,.10)',\n      rowBorder: you ? '#ffffff' : 'rgba(255,255,255,.28)',\n      rankBg: gold ? '#EAFBF1' : 'rgba(255,255,255,.16)',\n      rankColor: gold ? '#0B5B34' : '#fff',\n      avatarBg: you ? '#0B5B34' : 'rgba(255,255,255,.20)',\n      avatarColor: '#fff',\n      nameColor: you ? '#0B5B34' : '#fff',\n      subColor: you ? 'rgba(11,91,52,.75)' : 'rgba(255,255,255,.72)',\n      entriesColor: you ? '#0B5B34' : '#fff',\n      unitColor: you ? 'rgba(11,91,52,.6)' : 'rgba(255,255,255,.6)',\n    };\n  }\n\n  viewFeed(f) {\n    const ev = f.cat === 'EV';\n    return {\n      ...f,\n      badgeBg: ev ? '#E6EDFF' : '#FFF1C9',\n      badgeColor: ev ? '#1D53FF' : '#9A7B12',\n      tagText: ev ? 'EV Giveaway' : 'Finder Fridays',\n      tagBg: ev ? '#E6EDFF' : '#FFF1C9',\n      tagColor: ev ? '#1D53FF' : '#7A5C00',\n      note: ev ? 'EV draw only' : 'EV + Friday draw',\n      entriesLabel: '+' + this.fmt(f.entries),\n    };\n  }\n\n  renderVals() {\n    const userName = this.props.userName ?? 'Jason';\n    const evGoal = this.props.evGoal ?? 5000;\n    const pct = Math.min((this.state.evEntries / evGoal) * 100, 100);\n    return {\n      userName,\n      initial: userName.trim().charAt(0).toUpperCase() || 'J',\n      today: this.sydToday(true),\n      evCardRef: this.evCardRef,\n      evDisplay: this.fmt(this.state.evShown),\n      evRatio: this.fmt(this.state.evEntries) + ' / ' + this.fmt(evGoal),\n      evPct: pct + '%',\n      ffDisplay: this.fmt(this.state.ffShown),\n      cdD: this.state.cd.d, cdH: this.state.cd.h, cdM: this.state.cd.m, cdS: this.state.cd.s,\n      claimDisabled: this.state.claimDisabled,\n      claimLabel: this.state.claimDisabled ? 'Entry claimed' : 'Claim free entry',\n      claimBg: this.state.claimDisabled ? '#007828' : '#232320',\n      evTasksView: this.evTasks.map(t => this.viewTask(t)),\n      ffTasksView: this.ffTasks.map(t => this.viewTask(t)),\n      feedView: this.state.feed.map(f => this.viewFeed(f)),\n      leaderView: [...this.others, { name: userName + ' (you)', suburb: \"That's you\", entries: this.state.evShown, you: true }]\n        .sort((a, b) => b.entries - a.entries)\n        .map((l, i) => this.viewLeader(l, i + 1)),\n      showHelp: this.state.showHelp,\n      openHelp: () => this.setState({ showHelp: true }),\n      closeHelp: () => this.setState({ showHelp: false }),\n      stopProp: (e) => e.stopPropagation(),\n      claimFree: () => this.claimFree(),\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html>
