  <script type="__bundler/template">
"<!DOCTYPE html>\n<html><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<script src=\"1778dccf-38c9-4b3e-b961-548ec2e33a98\"><\u002Fscript>\n\n<\u002Fhead>\n<body>\n<x-dc>\n<helmet>\n<style>/* ==========================================================================\n   Finder Design System — Tokens\n   Type + Color variables (primitive + semantic)\n   Source: Figma \"📕 Finder Design System Library\" (Jul 2024)\n   ========================================================================== */\n\n/* ---- Fonts ----\n   Primary: \"Modern Era\" (Pangram Pangram) — bundled locally in /fonts.\n   Weights supplied: Regular 400, Medium 500, Bold 700, ExtraBold 800/900,\n   ExtraBold Italic 800/900. All italic display usage is covered.\n   Secondary: \"Geist\" — used in tokens UI only. */\n/* vietnamese */\n@font-face {\n  font-family: 'Archivo';\n  font-style: italic;\n  font-weight: 400 900;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"be935a02-7a80-44f2-8de1-cb1e807e8d5a\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Archivo';\n  font-style: italic;\n  font-weight: 400 900;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"8300c19c-e14b-4e3a-add1-04873b4e84de\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Archivo';\n  font-style: italic;\n  font-weight: 400 900;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"76f5ac88-9eee-4ee5-b1a1-a51b000aa1de\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Archivo';\n  font-style: normal;\n  font-weight: 400 900;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"440aa610-7e05-45b1-9d7a-4c81ebd6b096\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Archivo';\n  font-style: normal;\n  font-weight: 400 900;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"8183a1d4-0500-4f5c-a88e-05e3ccd59e14\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Archivo';\n  font-style: normal;\n  font-weight: 400 900;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"3df4ca5e-462e-4367-b86c-a7bbdb27a066\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"b4cb7ba0-dada-43fa-821d-608c2894bcad\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"4c7db854-7f76-41ac-bfcc-03c8996eb199\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"664f2812-35d9-4152-92c8-64555ddaf2c7\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"f6d9f535-458e-4c93-a6b7-dc8065499eee\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"1a54d598-e171-450a-bdad-7f14c558f3d9\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"b4cb7ba0-dada-43fa-821d-608c2894bcad\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"4c7db854-7f76-41ac-bfcc-03c8996eb199\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"664f2812-35d9-4152-92c8-64555ddaf2c7\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"f6d9f535-458e-4c93-a6b7-dc8065499eee\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"1a54d598-e171-450a-bdad-7f14c558f3d9\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"b4cb7ba0-dada-43fa-821d-608c2894bcad\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"4c7db854-7f76-41ac-bfcc-03c8996eb199\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"664f2812-35d9-4152-92c8-64555ddaf2c7\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"f6d9f535-458e-4c93-a6b7-dc8065499eee\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"1a54d598-e171-450a-bdad-7f14c558f3d9\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n\n\n@font-face {\n  font-family: \"Modern Era\";\n  src: url(\"23a84423-d4c8-49a7-bfe7-af79601b78c2\") format(\"opentype\");\n  font-weight: 400;\n  font-style: normal;\n  font-display: swap;\n}\n@font-face {\n  font-family: \"Modern Era\";\n  src: url(\"a8e9ad4c-bf2a-4e27-8510-21197b645dc5\") format(\"opentype\");\n  font-weight: 500;\n  font-style: normal;\n  font-display: swap;\n}\n@font-face {\n  font-family: \"Modern Era\";\n  src: url(\"4cf5a9c7-ae6e-4e70-86d9-bdf3d28b1a4b\") format(\"opentype\");\n  font-weight: 700;\n  font-style: normal;\n  font-display: swap;\n}\n@font-face {\n  font-family: \"Modern Era\";\n  src: url(\"3c8f0089-b5f9-4b55-9d41-c0511b8cc5d7\") format(\"opentype\");\n  font-weight: 800 900;\n  font-style: normal;\n  font-display: swap;\n}\n@font-face {\n  font-family: \"Modern Era\";\n  src: url(\"15926a28-f8a1-4081-8514-5e1becde59de\") format(\"opentype\");\n  font-weight: 800 900;\n  font-style: italic;\n  font-display: swap;\n}\n\n:root {\n  /* ---------- Typography families ---------- */\n  --ff-display: \"Modern Era\", \"Archivo\", system-ui, -apple-system, \"Segoe UI\", sans-serif; /* @kind font */\n  --ff-body:    \"Modern Era\", \"Archivo\", system-ui, -apple-system, \"Segoe UI\", sans-serif; /* @kind font */\n  --ff-mono:    \"Geist\", \"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace; /* @kind font */\n\n  /* ---------- Primitive colors (Tailwind v4 base) ---------- */\n  /* Neutrals */\n  --color-neutral-0:   #FFFFFF;\n  --color-neutral-50:  #FAFAFA;\n  --color-neutral-100: #F5F5F5;\n  --color-neutral-200: #E5E5E5;\n  --color-neutral-300: #D4D4D4;\n  --color-neutral-400: #A3A3A3;\n  --color-neutral-500: #737373;\n  --color-neutral-600: #525252;\n  --color-neutral-700: #404040;\n  --color-neutral-800: #262626;\n  --color-neutral-900: #171717;\n  --color-neutral-950: #0A0A0A;\n\n  /* Paper — warm off-white, the Finder signature surface */\n  --color-paper:       #F5F4EF;\n  --color-paper-2:     #E6E5E0;\n  --color-paper-3:     #D4D3CE;\n\n  /* Ink — near-black, slightly warm, used for all display text */\n  --color-ink:         #232320;\n  --color-ink-muted:   #41403B;\n  --color-ink-soft:    #74736E;\n\n  /* Brand */\n  --color-brand:            #1D53FF; /* primary CTA / links */\n  --color-brand-heavy:      #0A41EE;\n  --color-brand-neon:       #00B2FF; /* \"neon blue\" accent */\n\n  /* Accents */\n  --color-yellow:           #FFD23B;\n  --color-yellow-soft:      #FFFA8A;\n  --color-lime:             #C3F53C;\n  --color-pink:             #FF73A9;\n  --color-purple:           #B469FF;\n  --color-purple-heavy:     #9747FF;\n\n  /* Rewards — gold shimmer gradient (the signature \"Up to $X Rewards\" motif) */\n  --gold-1: #FFD23B;\n  --gold-2: #FED83D;\n  --gold-3: #FEE057;\n  --gold-4: #FDE777;\n  --gold-5: #FDF7A9;\n  --gold-6: #FDFFC4;\n  --gold-edge: #E6B40F;\n  --gold-ink: #092673; /* deep blue ink that sits on the gold pill */\n  --rewards-shimmer:\n    linear-gradient(\n      107.5deg,\n      var(--gold-1) 18%,\n      #FFD835 24%,\n      #FEDA3D 29%,\n      #FEE053 36%,\n      #FEEA77 45%,\n      var(--gold-5) 55%,\n      var(--gold-6) 60%,\n      #FDF8AC 62%,\n      #FDEE88 65%,\n      #FEE669 68%,\n      #FEE052 71%,\n      #FEDB41 75%,\n      #FED838 79%,\n      #FFD835 84%,\n      var(--gold-1) 90%\n    );\n\n  /* Utility / semantic */\n  --color-success:          #1DD751;\n  --color-success-deep:     #007828;\n  --color-danger:           #DB2420;\n  --color-warning:          #AF8310;\n  --color-warning-bg:       #D5A509;\n  --color-info:             #00B2FF;\n\n  /* Semantic — Foreground */\n  --fg-default:    var(--color-ink);\n  --fg-muted:      var(--color-ink-muted);\n  --fg-subtle:     var(--color-ink-soft);\n  --fg-inverse:    #FFFFFF;\n  --fg-brand:      var(--color-brand);\n  --fg-danger:     var(--color-danger);\n  --fg-success:    var(--color-success-deep);\n\n  /* Semantic — Background */\n  --bg-default:    #FFFFFF;\n  --bg-paper:      var(--color-paper);\n  --bg-subtle:     var(--color-paper-2);\n  --bg-ink:        var(--color-ink);\n  --bg-brand:      var(--color-brand);\n  --bg-brand-soft: #E6EDFF;\n  --bg-yellow:     var(--color-yellow);\n  --bg-lime:       var(--color-lime);\n\n  /* Semantic — Border */\n  --border-default: var(--color-paper-3);       /* #D4D3CE */\n  --border-strong:  var(--color-ink);           /* 4px emphasis */\n  --border-subtle:  rgba(0,0,0,0.08);\n\n  /* ---------- Radii (from component usage) ---------- */\n  --radius-xs:  4px;\n  --radius-sm:  8px;\n  --radius-md:  10px;   /* Size=40 input */\n  --radius-lg:  12px;   /* Size=48 input / button */\n  --radius-xl:  16px;   /* Cards */\n  --radius-2xl: 24px;   /* Pill / hero panels */\n  --radius-full: 9999px;\n\n  /* ---------- Spacing scale (8pt base) ---------- */\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-5: 20px;\n  --space-6: 24px;\n  --space-8: 32px;\n  --space-10: 40px;\n  --space-12: 48px;\n  --space-16: 64px;\n  --space-24: 96px;\n\n  /* ---------- Shadows ---------- */\n  /* Finder avoids heavy drop shadows; cards rely on paper→white contrast\n     + hairline borders. A subtle lift is used on hover and on pop-ups. */\n  --shadow-xs: 0 1px 2px rgba(35,35,32,0.06);\n  --shadow-sm: 0 2px 6px rgba(35,35,32,0.08);\n  --shadow-md: 0 8px 24px rgba(35,35,32,0.10);\n  --shadow-lg: 0 20px 40px rgba(35,35,32,0.12);\n\n  /* ---------- Type scale (raw sizes — semantic roles below) ---------- */\n  --fs-display-xxl: 156px; /* cover hero */\n  --fs-display-xl:  96px;\n  --fs-display-lg:  72px;\n  --fs-display-md:  60px;\n  --fs-h1: 48px;\n  --fs-h2: 36px;\n  --fs-h3: 30px;\n  --fs-h4: 20px;\n  --fs-h5: 16px;\n  --fs-h6: 14px;\n  --fs-body-lg: 18px;\n  --fs-body:    16px;\n  --fs-body-sm: 14px;\n  --fs-body-xs: 12px;\n  --fs-label-xl: 24px;\n  --fs-label-lg: 20px;\n  --fs-label-md: 16px;\n  --fs-label-sm: 14px;\n  --fs-label-xs: 12px;\n  --fs-button-lg: 18px;\n  --fs-button-md: 14px;\n  --fs-button-sm: 12px;\n}\n\n/* ============================================================\n   Semantic / element-level typography\n   Finder uses ExtraBold Italic at display, Bold (not italic) for\n   headings, Regular/Medium for body, and ExtraBold Italic ALL-CAPS\n   for buttons (marketing) / Medium sentence-case for buttons (app).\n   ============================================================ */\n\n.fds-display, .fds-display-xl {\n  font-family: var(--ff-display);\n  font-weight: 900;         /* Black */\n  font-style: italic;\n  font-size: var(--fs-display-xl);\n  line-height: 1.10;\n  letter-spacing: -0.04em;\n  color: var(--fg-default);\n}\n.fds-display-lg { font-size: var(--fs-display-lg); }\n.fds-display-md { font-size: var(--fs-display-md); }\n\n.fds-h1, .fds-h2, .fds-h3, .fds-h4, .fds-h5, .fds-h6 {\n  font-family: var(--ff-display);\n  font-weight: 700;         /* Bold, NOT italic */\n  font-style: normal;\n  line-height: 1.25;\n  letter-spacing: -0.01em;\n  color: var(--fg-default);\n}\n.fds-h1 { font-size: var(--fs-h1); }\n.fds-h2 { font-size: var(--fs-h2); }\n.fds-h3 { font-size: var(--fs-h3); }\n.fds-h4 { font-size: var(--fs-h4); }\n.fds-h5 { font-size: var(--fs-h5); }\n.fds-h6 { font-size: var(--fs-h6); }\n\n.fds-body-lg, .fds-body, .fds-body-sm, .fds-body-xs {\n  font-family: var(--ff-body);\n  font-weight: 400;\n  line-height: 1.50;\n  color: var(--fg-default);\n}\n.fds-body-lg { font-size: var(--fs-body-lg); }\n.fds-body    { font-size: var(--fs-body); }\n.fds-body-sm { font-size: var(--fs-body-sm); }\n.fds-body-xs { font-size: var(--fs-body-xs); }\n\n.fds-label {\n  font-family: var(--ff-body);\n  font-weight: 500;\n  line-height: 1.25;\n  color: var(--fg-default);\n}\n.fds-label.xl { font-size: var(--fs-label-xl); }\n.fds-label.lg { font-size: var(--fs-label-lg); }\n.fds-label.md { font-size: var(--fs-label-md); }\n.fds-label.sm { font-size: var(--fs-label-sm); }\n.fds-label.xs { font-size: var(--fs-label-xs); }\n\n/* Button label — the distinctive Finder voice: ExtraBold Italic ALL CAPS.\n   Used only in marketing. App buttons use .fds-button-app (Medium, sentence). */\n.fds-button {\n  font-family: var(--ff-display);\n  font-weight: 900;\n  font-style: italic;\n  text-transform: uppercase;\n  letter-spacing: 0.02em;\n  line-height: 1.25;\n  font-size: var(--fs-button-md);\n}\n.fds-button-app {\n  font-family: var(--ff-body);\n  font-weight: 500;\n  font-size: var(--fs-button-lg);\n  line-height: 28px;\n  text-transform: none;\n  letter-spacing: 0;\n}\n\n/* Eyebrow / small caps label, e.g. section titles in the semantic-colour section */\n.fds-eyebrow {\n  font-family: var(--ff-display);\n  font-weight: 700;\n  font-size: 14px;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n  color: var(--color-ink-muted);\n}\n<\u002Fstyle>\n<style>/* ==========================================================================\n   Sign-up offer banner — canonical component\n   Shared by:\n     · preview/components-sign-up-offer-banner.html\n     · preview/components-tables-internet.html\n     · preview/components-tables-fhl.html\n     · preview/components-tables-fhi.html\n\n   · Fill #E5FFED, 1px solid #1DD751 stroke\n   · 12px radius, 8/12 padding\n   · 20×20 gift glyph (assets/tables/gift.svg)\n   · Copy: Modern Era 400 14/20, ink-muted; <b> = ink, 700\n   ========================================================================== */\n\n.sob{\n  box-sizing:border-box;\n  background:#E5FFED;\n  border:1px solid var(--color-success);\n  border-radius:12px;\n  padding:8px 12px;\n  display:flex;align-items:flex-start;gap:8px;\n}\n.sob .gift{\n  width:20px;height:20px;flex:none;\n  display:flex;align-items:center;justify-content:center;\n}\n.sob .gift img{width:20px;height:20px;display:block}\n.sob p{\n  margin:0;\n  font-family:var(--ff-body);font-weight:400;\n  font-size:14px;line-height:20px;color:var(--color-ink-muted);\n}\n.sob p b{color:var(--color-ink);font-weight:700}\n<\u002Fstyle>\n<style>/* ==========================================================================\n   Finder · Tables (product comparison rows)\n   Shared component CSS used by:\n     · components-tables-internet.html\n     · components-tables-fhl.html\n     · components-tables-fhi.html\n   ========================================================================== */\n\n/* Page reset */\nhtml,body{margin:0;padding:0;background:var(--bg-paper);color:var(--fg-default);font-family:var(--ff-body)}\n.wrap{padding:32px;display:flex;flex-direction:column;gap:28px;align-items:flex-start}\n.lbl{font-family:var(--ff-mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-subtle);margin:0 0 12px}\n\n/* ---------- DESKTOP ROW SHELL ---------- */\n.tbl-row{\n  width:904px;\n  background:#fff;\n  border:1px solid var(--color-paper-3);\n  display:flex;\n  flex-direction:column;\n  font-family:var(--ff-body);\n  color:var(--color-ink);\n  box-sizing:border-box;\n}\n.tbl-row .tag-strip{\n  display:flex;align-items:center;gap:6px;\n  padding:12px 16px 0;\n}\n.tbl-row .tag-strip + .tbl-row .tag-strip{padding-top:0}\n\n/* ---------- TINY PILL BADGES ---------- */\n.tb-badge{\n  display:inline-flex;align-items:center;\n  height:20px;padding:0 8px;\n  border-radius:9999px;\n  font-family:var(--ff-display);\n  font-style:italic;font-weight:800;\n  font-size:11px;line-height:1;\n  letter-spacing:.04em;\n  text-transform:uppercase;\n  white-space:nowrap;\n}\n.tb-badge.promoted{ background:var(--color-yellow); color:var(--color-ink); }\n.tb-badge.exclusive{ background:var(--color-brand); color:#fff; }\n.tb-badge.award{ background:var(--color-yellow); color:var(--color-ink); }\n.tb-badge.green{ background:#E5FFED; color:var(--color-success-deep); border:1px solid var(--color-success); }\n\n/* Outline product-attribute tag — matches attribute.svg visual treatment\n   (fill #F5F4EF, no border). Use this for variable-text grey badges. */\n.tb-attr{\n  display:inline-flex;align-items:center;\n  height:20px;padding:0 10px;\n  border-radius:9999px;\n  background:var(--color-paper);\n  color:var(--color-ink);\n  font-family:var(--ff-body);\n  font-weight:500;\n  font-size:12px;line-height:1;\n  border:0;\n}\n\n/* Static badge images — use these in place of CSS pills when the\n   badge has fixed text. See /assets/badges/*.svg + components-badges. */\n.tb-badge-img{\n  height:20px;width:auto;display:inline-block;flex:none;\n}\n\n/* \"Save $X\" red pill (sale callout in highlight cards / mobile price plate) */\n.tb-save{\n  display:inline-flex;align-items:center;justify-content:center;\n  height:20px;padding:0 8px;\n  border-radius:9999px;\n  background:var(--color-danger);color:#fff;\n  font-family:var(--ff-display);font-weight:700;font-style:italic;\n  font-size:11px;line-height:1;letter-spacing:.04em;\n  text-transform:uppercase;\n}\n\n/* ---------- HEADER (logo + name + actions) ---------- */\n.tb-head{\n  display:flex;align-items:center;gap:16px;\n  padding:12px 16px 16px;\n}\n.tb-head .logo{\n  flex:0 0 96px;height:40px;\n  display:flex;align-items:center;justify-content:center;\n}\n.tb-head .logo img{max-width:100%;max-height:100%;display:block}\n.tb-head .name-block{flex:1 1 auto;display:flex;flex-direction:column;gap:6px;min-width:0}\n.tb-head .name{\n  font-family:var(--ff-body);font-weight:500;\n  font-size:16px;line-height:24px;color:var(--color-ink);\n}\n.tb-head .name-badges{display:flex;align-items:center;gap:4px;flex-wrap:wrap}\n.tb-head .actions{display:flex;align-items:center;gap:8px;flex:0 0 auto}\n\n/* in-product 'system' buttons (View details, Compare) */\n.tb-btn{\n  height:40px;border-radius:10px;\n  padding:0 16px;\n  display:inline-flex;align-items:center;gap:8px;\n  font-family:var(--ff-body);font-weight:500;\n  font-size:14px;line-height:1;\n  background:#fff;color:var(--color-ink);\n  border:1px solid var(--color-paper-3);\n  cursor:pointer;\n  white-space:nowrap;\n}\n.tb-btn svg{width:16px;height:16px;flex:none}\n.tb-btn.primary{\n  background:var(--color-brand);color:#fff;border-color:var(--color-brand);\n  font-family:var(--ff-display);font-style:italic;font-weight:800;\n  text-transform:uppercase;letter-spacing:.02em;\n  padding:0 20px;\n}\n\n/* ---------- DATA CELL GRID ---------- */\n.tb-data{\n  display:grid;\n  grid-template-columns: 217px 217px 217px 1fr;\n}\n.tb-cell{\n  padding:12px 16px;\n  display:flex;flex-direction:column;align-items:center;justify-content:center;\n  text-align:center;\n  min-height:100px;\n}\n.tb-cell .big{\n  font-family:var(--ff-display);font-weight:700;\n  font-size:20px;line-height:1.25;color:var(--color-ink);\n}\n.tb-cell .sub{\n  font-family:var(--ff-body);font-weight:400;\n  font-size:14px;line-height:20px;color:var(--color-ink-muted);\n}\n.tb-cell .info{\n  display:inline-flex;align-items:center;gap:4px;\n}\n.tb-cell .info-i{\n  width:14px;height:14px;border-radius:50%;\n  background:var(--color-paper);\n  border:1px solid var(--color-paper-3);\n  display:inline-flex;align-items:center;justify-content:center;\n  font-size:9px;color:var(--color-ink-soft);font-weight:700;font-style:italic;\n}\n\n/* Highlight container (the right-most cell with a deal box) */\n.tb-highlight{\n  margin:8px;\n  background:#E5F7FF;\n  border:1px solid var(--color-info);\n  border-radius:12px;\n  padding:10px 12px;\n  display:flex;flex-direction:column;gap:4px;align-items:center;\n  text-align:center;\n  min-width:0;\n  align-self:stretch;\n}\n.tb-highlight .deal-badge{\n  display:inline-flex;align-items:center;justify-content:center;\n  height:20px;padding:0 8px;\n  background:var(--color-danger);\n  color:#fff;\n  border-radius:9999px;\n  font-family:var(--ff-display);font-weight:700;\n  font-size:12px;line-height:1;letter-spacing:.02em;\n}\n.tb-highlight .deal-prices{display:flex;align-items:baseline;gap:8px}\n.tb-highlight .strike{\n  font-family:var(--ff-body);font-weight:500;\n  font-size:16px;color:var(--color-ink);\n  text-decoration:line-through;\n}\n.tb-highlight .price{\n  font-family:var(--ff-display);font-weight:700;\n  font-size:30px;line-height:1.05;color:var(--color-danger);\n  letter-spacing:-0.025em;\n}\n.tb-highlight .note{\n  font-family:var(--ff-body);font-size:14px;line-height:20px;color:var(--color-ink);\n}\n\n/* Save-callout (FHL desktop) — light blue pill under monthly payment */\n.tb-save-pill{\n  display:inline-flex;align-items:center;\n  height:22px;padding:0 8px;\n  border-radius:9999px;\n  background:#E5F7FF;\n  border:1px solid var(--color-info);\n  color:var(--color-ink);\n  font-family:var(--ff-body);font-weight:500;\n  font-size:13px;line-height:1;\n  margin-top:6px;\n}\n.tb-save-pill b{font-weight:700;margin-right:2px}\n\n/* Bullet list (FHI) — green check / red X rows */\n.tb-bullets{\n  display:flex;flex-direction:column;gap:6px;\n  align-items:flex-start;\n  text-align:left;\n  width:100%;\n  padding:4px 0;\n}\n.tb-bullets .h{\n  font-family:var(--ff-display);font-weight:700;\n  font-size:15px;line-height:20px;color:var(--color-ink);\n  margin-bottom:2px;\n}\n.tb-bullets ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:4px}\n.tb-bullets li{\n  display:flex;align-items:center;gap:6px;\n  font-size:14px;line-height:20px;color:var(--color-ink);\n}\n.tb-bullets li svg{flex:none;width:16px;height:16px}\n.tb-bullets .more{\n  color:var(--color-brand);\n  font-size:14px;line-height:20px;\n  text-decoration:underline;\n  font-weight:500;\n  margin-top:2px;\n  cursor:pointer;\n}\n\n/* ---------- MOBILE CARD ---------- */\n.tbl-card{\n  width:358px;\n  background:#fff;\n  border:1px solid var(--color-paper-3);\n  border-radius:12px;\n  display:flex;flex-direction:column;\n  font-family:var(--ff-body);\n  color:var(--color-ink);\n  overflow:hidden;\n  box-sizing:border-box;\n}\n.tbl-card .top{padding:16px 16px 0;display:flex;flex-direction:column;gap:8px}\n.tbl-card .top-row{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}\n.tbl-card .logo{height:36px;max-width:120px;display:flex;align-items:center}\n.tbl-card .logo img{max-width:100%;max-height:100%}\n.tbl-card .name{font-family:var(--ff-body);font-weight:500;font-size:16px;line-height:22px;color:var(--color-ink)}\n.tbl-card .name-sub{font-size:13px;line-height:18px;color:var(--color-ink-soft);font-family:var(--ff-mono)}\n.tbl-card .price-block{\n  margin:12px 16px 0;\n  border:1px solid var(--color-paper-3);\n  border-radius:12px;\n  padding:14px;\n  text-align:center;\n}\n.tbl-card .price-block .big{\n  font-family:var(--ff-display);font-weight:800;font-size:28px;line-height:1;color:var(--color-ink);\n  letter-spacing:-0.02em;\n}\n.tbl-card .price-block .strike{text-decoration:line-through;color:var(--color-ink-soft);font-weight:500;font-size:16px;margin-right:6px}\n.tbl-card .price-block .red{color:var(--color-danger)}\n.tbl-card .price-block .sub{margin-top:4px;font-size:13px;color:var(--color-ink-muted)}\n.tbl-card .mid-cells{\n  display:grid;grid-template-columns:1fr 1fr;gap:1px;\n  background:var(--color-paper-3);\n  margin:12px 0 0;\n  border-top:1px solid var(--color-paper-3);\n  border-bottom:1px solid var(--color-paper-3);\n}\n.tbl-card .mid-cells .c{\n  background:#fff;padding:10px 14px;display:flex;flex-direction:column;gap:2px;\n}\n.tbl-card .mid-cells .c .label{font-size:12px;color:var(--color-ink-soft)}\n.tbl-card .mid-cells .c .v{font-family:var(--ff-display);font-weight:700;font-size:16px;color:var(--color-ink)}\n.tbl-card .offer{\n  margin:12px 16px;\n  background:#E5FFED;\n  border:1px solid var(--color-success);\n  border-radius:12px;\n  padding:8px 12px;\n  display:flex;align-items:flex-start;gap:8px;\n}\n.tbl-card .offer p{margin:0;font-size:13px;line-height:18px;color:var(--color-ink-muted)}\n.tbl-card .offer p b{color:var(--color-ink);font-weight:700}\n.tbl-card .footer-cta{\n  padding:0 16px 12px;display:flex;flex-direction:column;gap:8px;\n}\n.tbl-card .footer-cta .tb-btn.primary{height:48px;font-size:16px;border-radius:12px}\n.tbl-card .footer-cta .row{display:flex;gap:8px}\n.tbl-card .footer-cta .row .tb-btn{flex:1;justify-content:center}\n<\u002Fstyle>\n<style>/* ==========================================================================\n   Finder Design System — root stylesheet\n   Single entrypoint for consumers. Link this one file:\n     <link rel=\"stylesheet\" href=\"styles.css\">\n   It pulls in the design tokens plus the canonical component stylesheets.\n   ========================================================================== */\n\n/* Design tokens — colour, type, radius, spacing (must load first) */\n/* ==========================================================================\n   Finder Design System — Tokens\n   Type + Color variables (primitive + semantic)\n   Source: Figma \"📕 Finder Design System Library\" (Jul 2024)\n   ========================================================================== */\n\n/* ---- Fonts ----\n   Primary: \"Modern Era\" (Pangram Pangram) — bundled locally in /fonts.\n   Weights supplied: Regular 400, Medium 500, Bold 700, ExtraBold 800/900,\n   ExtraBold Italic 800/900. All italic display usage is covered.\n   Secondary: \"Geist\" — used in tokens UI only. */\n/* vietnamese */\n@font-face {\n  font-family: 'Archivo';\n  font-style: italic;\n  font-weight: 400 900;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"be935a02-7a80-44f2-8de1-cb1e807e8d5a\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Archivo';\n  font-style: italic;\n  font-weight: 400 900;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"8300c19c-e14b-4e3a-add1-04873b4e84de\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Archivo';\n  font-style: italic;\n  font-weight: 400 900;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"76f5ac88-9eee-4ee5-b1a1-a51b000aa1de\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Archivo';\n  font-style: normal;\n  font-weight: 400 900;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"440aa610-7e05-45b1-9d7a-4c81ebd6b096\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Archivo';\n  font-style: normal;\n  font-weight: 400 900;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"8183a1d4-0500-4f5c-a88e-05e3ccd59e14\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Archivo';\n  font-style: normal;\n  font-weight: 400 900;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"3df4ca5e-462e-4367-b86c-a7bbdb27a066\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"b4cb7ba0-dada-43fa-821d-608c2894bcad\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"4c7db854-7f76-41ac-bfcc-03c8996eb199\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"664f2812-35d9-4152-92c8-64555ddaf2c7\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"f6d9f535-458e-4c93-a6b7-dc8065499eee\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"1a54d598-e171-450a-bdad-7f14c558f3d9\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"b4cb7ba0-dada-43fa-821d-608c2894bcad\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"4c7db854-7f76-41ac-bfcc-03c8996eb199\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"664f2812-35d9-4152-92c8-64555ddaf2c7\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"f6d9f535-458e-4c93-a6b7-dc8065499eee\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"1a54d598-e171-450a-bdad-7f14c558f3d9\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"b4cb7ba0-dada-43fa-821d-608c2894bcad\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"4c7db854-7f76-41ac-bfcc-03c8996eb199\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"664f2812-35d9-4152-92c8-64555ddaf2c7\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"f6d9f535-458e-4c93-a6b7-dc8065499eee\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"1a54d598-e171-450a-bdad-7f14c558f3d9\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n\n\n@font-face {\n  font-family: \"Modern Era\";\n  src: url(\"23a84423-d4c8-49a7-bfe7-af79601b78c2\") format(\"opentype\");\n  font-weight: 400;\n  font-style: normal;\n  font-display: swap;\n}\n@font-face {\n  font-family: \"Modern Era\";\n  src: url(\"a8e9ad4c-bf2a-4e27-8510-21197b645dc5\") format(\"opentype\");\n  font-weight: 500;\n  font-style: normal;\n  font-display: swap;\n}\n@font-face {\n  font-family: \"Modern Era\";\n  src: url(\"4cf5a9c7-ae6e-4e70-86d9-bdf3d28b1a4b\") format(\"opentype\");\n  font-weight: 700;\n  font-style: normal;\n  font-display: swap;\n}\n@font-face {\n  font-family: \"Modern Era\";\n  src: url(\"3c8f0089-b5f9-4b55-9d41-c0511b8cc5d7\") format(\"opentype\");\n  font-weight: 800 900;\n  font-style: normal;\n  font-display: swap;\n}\n@font-face {\n  font-family: \"Modern Era\";\n  src: url(\"15926a28-f8a1-4081-8514-5e1becde59de\") format(\"opentype\");\n  font-weight: 800 900;\n  font-style: italic;\n  font-display: swap;\n}\n\n:root {\n  /* ---------- Typography families ---------- */\n  --ff-display: \"Modern Era\", \"Archivo\", system-ui, -apple-system, \"Segoe UI\", sans-serif; /* @kind font */\n  --ff-body:    \"Modern Era\", \"Archivo\", system-ui, -apple-system, \"Segoe UI\", sans-serif; /* @kind font */\n  --ff-mono:    \"Geist\", \"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace; /* @kind font */\n\n  /* ---------- Primitive colors (Tailwind v4 base) ---------- */\n  /* Neutrals */\n  --color-neutral-0:   #FFFFFF;\n  --color-neutral-50:  #FAFAFA;\n  --color-neutral-100: #F5F5F5;\n  --color-neutral-200: #E5E5E5;\n  --color-neutral-300: #D4D4D4;\n  --color-neutral-400: #A3A3A3;\n  --color-neutral-500: #737373;\n  --color-neutral-600: #525252;\n  --color-neutral-700: #404040;\n  --color-neutral-800: #262626;\n  --color-neutral-900: #171717;\n  --color-neutral-950: #0A0A0A;\n\n  /* Paper — warm off-white, the Finder signature surface */\n  --color-paper:       #F5F4EF;\n  --color-paper-2:     #E6E5E0;\n  --color-paper-3:     #D4D3CE;\n\n  /* Ink — near-black, slightly warm, used for all display text */\n  --color-ink:         #232320;\n  --color-ink-muted:   #41403B;\n  --color-ink-soft:    #74736E;\n\n  /* Brand */\n  --color-brand:            #1D53FF; /* primary CTA / links */\n  --color-brand-heavy:      #0A41EE;\n  --color-brand-neon:       #00B2FF; /* \"neon blue\" accent */\n\n  /* Accents */\n  --color-yellow:           #FFD23B;\n  --color-yellow-soft:      #FFFA8A;\n  --color-lime:             #C3F53C;\n  --color-pink:             #FF73A9;\n  --color-purple:           #B469FF;\n  --color-purple-heavy:     #9747FF;\n\n  /* Rewards — gold shimmer gradient (the signature \"Up to $X Rewards\" motif) */\n  --gold-1: #FFD23B;\n  --gold-2: #FED83D;\n  --gold-3: #FEE057;\n  --gold-4: #FDE777;\n  --gold-5: #FDF7A9;\n  --gold-6: #FDFFC4;\n  --gold-edge: #E6B40F;\n  --gold-ink: #092673; /* deep blue ink that sits on the gold pill */\n  --rewards-shimmer:\n    linear-gradient(\n      107.5deg,\n      var(--gold-1) 18%,\n      #FFD835 24%,\n      #FEDA3D 29%,\n      #FEE053 36%,\n      #FEEA77 45%,\n      var(--gold-5) 55%,\n      var(--gold-6) 60%,\n      #FDF8AC 62%,\n      #FDEE88 65%,\n      #FEE669 68%,\n      #FEE052 71%,\n      #FEDB41 75%,\n      #FED838 79%,\n      #FFD835 84%,\n      var(--gold-1) 90%\n    );\n\n  /* Utility / semantic */\n  --color-success:          #1DD751;\n  --color-success-deep:     #007828;\n  --color-danger:           #DB2420;\n  --color-warning:          #AF8310;\n  --color-warning-bg:       #D5A509;\n  --color-info:             #00B2FF;\n\n  /* Semantic — Foreground */\n  --fg-default:    var(--color-ink);\n  --fg-muted:      var(--color-ink-muted);\n  --fg-subtle:     var(--color-ink-soft);\n  --fg-inverse:    #FFFFFF;\n  --fg-brand:      var(--color-brand);\n  --fg-danger:     var(--color-danger);\n  --fg-success:    var(--color-success-deep);\n\n  /* Semantic — Background */\n  --bg-default:    #FFFFFF;\n  --bg-paper:      var(--color-paper);\n  --bg-subtle:     var(--color-paper-2);\n  --bg-ink:        var(--color-ink);\n  --bg-brand:      var(--color-brand);\n  --bg-brand-soft: #E6EDFF;\n  --bg-yellow:     var(--color-yellow);\n  --bg-lime:       var(--color-lime);\n\n  /* Semantic — Border */\n  --border-default: var(--color-paper-3);       /* #D4D3CE */\n  --border-strong:  var(--color-ink);           /* 4px emphasis */\n  --border-subtle:  rgba(0,0,0,0.08);\n\n  /* ---------- Radii (from component usage) ---------- */\n  --radius-xs:  4px;\n  --radius-sm:  8px;\n  --radius-md:  10px;   /* Size=40 input */\n  --radius-lg:  12px;   /* Size=48 input / button */\n  --radius-xl:  16px;   /* Cards */\n  --radius-2xl: 24px;   /* Pill / hero panels */\n  --radius-full: 9999px;\n\n  /* ---------- Spacing scale (8pt base) ---------- */\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-5: 20px;\n  --space-6: 24px;\n  --space-8: 32px;\n  --space-10: 40px;\n  --space-12: 48px;\n  --space-16: 64px;\n  --space-24: 96px;\n\n  /* ---------- Shadows ---------- */\n  /* Finder avoids heavy drop shadows; cards rely on paper→white contrast\n     + hairline borders. A subtle lift is used on hover and on pop-ups. */\n  --shadow-xs: 0 1px 2px rgba(35,35,32,0.06);\n  --shadow-sm: 0 2px 6px rgba(35,35,32,0.08);\n  --shadow-md: 0 8px 24px rgba(35,35,32,0.10);\n  --shadow-lg: 0 20px 40px rgba(35,35,32,0.12);\n\n  /* ---------- Type scale (raw sizes — semantic roles below) ---------- */\n  --fs-display-xxl: 156px; /* cover hero */\n  --fs-display-xl:  96px;\n  --fs-display-lg:  72px;\n  --fs-display-md:  60px;\n  --fs-h1: 48px;\n  --fs-h2: 36px;\n  --fs-h3: 30px;\n  --fs-h4: 20px;\n  --fs-h5: 16px;\n  --fs-h6: 14px;\n  --fs-body-lg: 18px;\n  --fs-body:    16px;\n  --fs-body-sm: 14px;\n  --fs-body-xs: 12px;\n  --fs-label-xl: 24px;\n  --fs-label-lg: 20px;\n  --fs-label-md: 16px;\n  --fs-label-sm: 14px;\n  --fs-label-xs: 12px;\n  --fs-button-lg: 18px;\n  --fs-button-md: 14px;\n  --fs-button-sm: 12px;\n}\n\n/* ============================================================\n   Semantic / element-level typography\n   Finder uses ExtraBold Italic at display, Bold (not italic) for\n   headings, Regular/Medium for body, and ExtraBold Italic ALL-CAPS\n   for buttons (marketing) / Medium sentence-case for buttons (app).\n   ============================================================ */\n\n.fds-display, .fds-display-xl {\n  font-family: var(--ff-display);\n  font-weight: 900;         /* Black */\n  font-style: italic;\n  font-size: var(--fs-display-xl);\n  line-height: 1.10;\n  letter-spacing: -0.04em;\n  color: var(--fg-default);\n}\n.fds-display-lg { font-size: var(--fs-display-lg); }\n.fds-display-md { font-size: var(--fs-display-md); }\n\n.fds-h1, .fds-h2, .fds-h3, .fds-h4, .fds-h5, .fds-h6 {\n  font-family: var(--ff-display);\n  font-weight: 700;         /* Bold, NOT italic */\n  font-style: normal;\n  line-height: 1.25;\n  letter-spacing: -0.01em;\n  color: var(--fg-default);\n}\n.fds-h1 { font-size: var(--fs-h1); }\n.fds-h2 { font-size: var(--fs-h2); }\n.fds-h3 { font-size: var(--fs-h3); }\n.fds-h4 { font-size: var(--fs-h4); }\n.fds-h5 { font-size: var(--fs-h5); }\n.fds-h6 { font-size: var(--fs-h6); }\n\n.fds-body-lg, .fds-body, .fds-body-sm, .fds-body-xs {\n  font-family: var(--ff-body);\n  font-weight: 400;\n  line-height: 1.50;\n  color: var(--fg-default);\n}\n.fds-body-lg { font-size: var(--fs-body-lg); }\n.fds-body    { font-size: var(--fs-body); }\n.fds-body-sm { font-size: var(--fs-body-sm); }\n.fds-body-xs { font-size: var(--fs-body-xs); }\n\n.fds-label {\n  font-family: var(--ff-body);\n  font-weight: 500;\n  line-height: 1.25;\n  color: var(--fg-default);\n}\n.fds-label.xl { font-size: var(--fs-label-xl); }\n.fds-label.lg { font-size: var(--fs-label-lg); }\n.fds-label.md { font-size: var(--fs-label-md); }\n.fds-label.sm { font-size: var(--fs-label-sm); }\n.fds-label.xs { font-size: var(--fs-label-xs); }\n\n/* Button label — the distinctive Finder voice: ExtraBold Italic ALL CAPS.\n   Used only in marketing. App buttons use .fds-button-app (Medium, sentence). */\n.fds-button {\n  font-family: var(--ff-display);\n  font-weight: 900;\n  font-style: italic;\n  text-transform: uppercase;\n  letter-spacing: 0.02em;\n  line-height: 1.25;\n  font-size: var(--fs-button-md);\n}\n.fds-button-app {\n  font-family: var(--ff-body);\n  font-weight: 500;\n  font-size: var(--fs-button-lg);\n  line-height: 28px;\n  text-transform: none;\n  letter-spacing: 0;\n}\n\n/* Eyebrow / small caps label, e.g. section titles in the semantic-colour section */\n.fds-eyebrow {\n  font-family: var(--ff-display);\n  font-weight: 700;\n  font-size: 14px;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n  color: var(--color-ink-muted);\n}\n\n\n/* Canonical component stylesheets */\n/* ==========================================================================\n   Finder Score — canonical component\n   Single source of truth shared by:\n     · preview/brand-finder-score.html\n     · preview/components-tables-internet.html  (mobile card)\n     · preview/components-tables-fhl.html       (desktop + mobile)\n     · preview/components-tables-fhi.html       (mobile card)\n\n   Geometry:  40×40 shield, radius 2/24/24/24 (square top-left only)\n   Number:    Modern Era ExtraBold 20/20, -0.025em letter-spacing\n   Info \"i\":  14×14 SVG overlapping the top-right corner\n   ========================================================================== */\n\n.fs{\n  display:inline-flex;\n  gap:8px;\n  align-items:center;\n  font-family:var(--ff-body);\n}\n.fs .score{\n  position:relative;\n  width:40px;height:40px;\n  border-radius:2px 24px 24px 24px;\n  display:flex;align-items:center;justify-content:center;\n  flex:none;\n}\n.fs .score .n{\n  font-family:var(--ff-display);\n  font-weight:700;\n  font-size:20px;line-height:20px;\n  letter-spacing:-0.025em;\n  color:#fff;\n}\n.fs .info{\n  position:absolute;\n  right:-3px;top:-3px;\n  width:14px;height:14px;\n  background: url(\"bef1b438-ff49-487b-8d0f-8e530b83fc74\") center/14px 14px no-repeat;\n}\n\n/* Tier colour variants — map straight to brand tokens */\n.fs.excellent .score{ background: var(--color-brand); }\n.fs.great     .score{ background: var(--color-success-deep); }\n.fs.standard  .score{ background: var(--color-yellow); }\n.fs.standard  .score .n{ color: var(--color-ink); }     /* yellow needs ink */\n.fs.poor      .score{ background: var(--color-danger); }\n.fs.na        .score{\n  background: var(--color-paper);\n  border:1px dashed var(--color-paper-3);\n}\n\n/* Right-hand text block (horizontal) */\n.fs .txt{display:flex;flex-direction:column;gap:0;line-height:1}\n.fs .txt .l{\n  font-family:var(--ff-body);\n  font-weight:500;\n  font-size:12px;line-height:16px;\n  color:var(--color-ink-soft);\n}\n.fs .txt .t{\n  font-family:var(--ff-display);\n  font-weight:700;\n  font-size:16px;line-height:20px;\n  color:var(--color-ink);\n}\n\n/* Vertical layout — number on top, tier label below */\n.fs.vertical{\n  flex-direction:column;\n  align-items:center;\n  gap:4px;\n}\n.fs.vertical .txt{align-items:center;text-align:center}\n\n/* ==========================================================================\n   Sign-up offer banner — canonical component\n   Shared by:\n     · preview/components-sign-up-offer-banner.html\n     · preview/components-tables-internet.html\n     · preview/components-tables-fhl.html\n     · preview/components-tables-fhi.html\n\n   · Fill #E5FFED, 1px solid #1DD751 stroke\n   · 12px radius, 8/12 padding\n   · 20×20 gift glyph (assets/tables/gift.svg)\n   · Copy: Modern Era 400 14/20, ink-muted; <b> = ink, 700\n   ========================================================================== */\n\n.sob{\n  box-sizing:border-box;\n  background:#E5FFED;\n  border:1px solid var(--color-success);\n  border-radius:12px;\n  padding:8px 12px;\n  display:flex;align-items:flex-start;gap:8px;\n}\n.sob .gift{\n  width:20px;height:20px;flex:none;\n  display:flex;align-items:center;justify-content:center;\n}\n.sob .gift img{width:20px;height:20px;display:block}\n.sob p{\n  margin:0;\n  font-family:var(--ff-body);font-weight:400;\n  font-size:14px;line-height:20px;color:var(--color-ink-muted);\n}\n.sob p b{color:var(--color-ink);font-weight:700}\n\n/* ==========================================================================\n   Finder · Tables (product comparison rows)\n   Shared component CSS used by:\n     · components-tables-internet.html\n     · components-tables-fhl.html\n     · components-tables-fhi.html\n   ========================================================================== */\n\n/* Page reset */\nhtml,body{margin:0;padding:0;background:var(--bg-paper);color:var(--fg-default);font-family:var(--ff-body)}\n.wrap{padding:32px;display:flex;flex-direction:column;gap:28px;align-items:flex-start}\n.lbl{font-family:var(--ff-mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-subtle);margin:0 0 12px}\n\n/* ---------- DESKTOP ROW SHELL ---------- */\n.tbl-row{\n  width:904px;\n  background:#fff;\n  border:1px solid var(--color-paper-3);\n  display:flex;\n  flex-direction:column;\n  font-family:var(--ff-body);\n  color:var(--color-ink);\n  box-sizing:border-box;\n}\n.tbl-row .tag-strip{\n  display:flex;align-items:center;gap:6px;\n  padding:12px 16px 0;\n}\n.tbl-row .tag-strip + .tbl-row .tag-strip{padding-top:0}\n\n/* ---------- TINY PILL BADGES ---------- */\n.tb-badge{\n  display:inline-flex;align-items:center;\n  height:20px;padding:0 8px;\n  border-radius:9999px;\n  font-family:var(--ff-display);\n  font-style:italic;font-weight:800;\n  font-size:11px;line-height:1;\n  letter-spacing:.04em;\n  text-transform:uppercase;\n  white-space:nowrap;\n}\n.tb-badge.promoted{ background:var(--color-yellow); color:var(--color-ink); }\n.tb-badge.exclusive{ background:var(--color-brand); color:#fff; }\n.tb-badge.award{ background:var(--color-yellow); color:var(--color-ink); }\n.tb-badge.green{ background:#E5FFED; color:var(--color-success-deep); border:1px solid var(--color-success); }\n\n/* Outline product-attribute tag — matches attribute.svg visual treatment\n   (fill #F5F4EF, no border). Use this for variable-text grey badges. */\n.tb-attr{\n  display:inline-flex;align-items:center;\n  height:20px;padding:0 10px;\n  border-radius:9999px;\n  background:var(--color-paper);\n  color:var(--color-ink);\n  font-family:var(--ff-body);\n  font-weight:500;\n  font-size:12px;line-height:1;\n  border:0;\n}\n\n/* Static badge images — use these in place of CSS pills when the\n   badge has fixed text. See /assets/badges/*.svg + components-badges. */\n.tb-badge-img{\n  height:20px;width:auto;display:inline-block;flex:none;\n}\n\n/* \"Save $X\" red pill (sale callout in highlight cards / mobile price plate) */\n.tb-save{\n  display:inline-flex;align-items:center;justify-content:center;\n  height:20px;padding:0 8px;\n  border-radius:9999px;\n  background:var(--color-danger);color:#fff;\n  font-family:var(--ff-display);font-weight:700;font-style:italic;\n  font-size:11px;line-height:1;letter-spacing:.04em;\n  text-transform:uppercase;\n}\n\n/* ---------- HEADER (logo + name + actions) ---------- */\n.tb-head{\n  display:flex;align-items:center;gap:16px;\n  padding:12px 16px 16px;\n}\n.tb-head .logo{\n  flex:0 0 96px;height:40px;\n  display:flex;align-items:center;justify-content:center;\n}\n.tb-head .logo img{max-width:100%;max-height:100%;display:block}\n.tb-head .name-block{flex:1 1 auto;display:flex;flex-direction:column;gap:6px;min-width:0}\n.tb-head .name{\n  font-family:var(--ff-body);font-weight:500;\n  font-size:16px;line-height:24px;color:var(--color-ink);\n}\n.tb-head .name-badges{display:flex;align-items:center;gap:4px;flex-wrap:wrap}\n.tb-head .actions{display:flex;align-items:center;gap:8px;flex:0 0 auto}\n\n/* in-product 'system' buttons (View details, Compare) */\n.tb-btn{\n  height:40px;border-radius:10px;\n  padding:0 16px;\n  display:inline-flex;align-items:center;gap:8px;\n  font-family:var(--ff-body);font-weight:500;\n  font-size:14px;line-height:1;\n  background:#fff;color:var(--color-ink);\n  border:1px solid var(--color-paper-3);\n  cursor:pointer;\n  white-space:nowrap;\n}\n.tb-btn svg{width:16px;height:16px;flex:none}\n.tb-btn.primary{\n  background:var(--color-brand);color:#fff;border-color:var(--color-brand);\n  font-family:var(--ff-display);font-style:italic;font-weight:800;\n  text-transform:uppercase;letter-spacing:.02em;\n  padding:0 20px;\n}\n\n/* ---------- DATA CELL GRID ---------- */\n.tb-data{\n  display:grid;\n  grid-template-columns: 217px 217px 217px 1fr;\n}\n.tb-cell{\n  padding:12px 16px;\n  display:flex;flex-direction:column;align-items:center;justify-content:center;\n  text-align:center;\n  min-height:100px;\n}\n.tb-cell .big{\n  font-family:var(--ff-display);font-weight:700;\n  font-size:20px;line-height:1.25;color:var(--color-ink);\n}\n.tb-cell .sub{\n  font-family:var(--ff-body);font-weight:400;\n  font-size:14px;line-height:20px;color:var(--color-ink-muted);\n}\n.tb-cell .info{\n  display:inline-flex;align-items:center;gap:4px;\n}\n.tb-cell .info-i{\n  width:14px;height:14px;border-radius:50%;\n  background:var(--color-paper);\n  border:1px solid var(--color-paper-3);\n  display:inline-flex;align-items:center;justify-content:center;\n  font-size:9px;color:var(--color-ink-soft);font-weight:700;font-style:italic;\n}\n\n/* Highlight container (the right-most cell with a deal box) */\n.tb-highlight{\n  margin:8px;\n  background:#E5F7FF;\n  border:1px solid var(--color-info);\n  border-radius:12px;\n  padding:10px 12px;\n  display:flex;flex-direction:column;gap:4px;align-items:center;\n  text-align:center;\n  min-width:0;\n  align-self:stretch;\n}\n.tb-highlight .deal-badge{\n  display:inline-flex;align-items:center;justify-content:center;\n  height:20px;padding:0 8px;\n  background:var(--color-danger);\n  color:#fff;\n  border-radius:9999px;\n  font-family:var(--ff-display);font-weight:700;\n  font-size:12px;line-height:1;letter-spacing:.02em;\n}\n.tb-highlight .deal-prices{display:flex;align-items:baseline;gap:8px}\n.tb-highlight .strike{\n  font-family:var(--ff-body);font-weight:500;\n  font-size:16px;color:var(--color-ink);\n  text-decoration:line-through;\n}\n.tb-highlight .price{\n  font-family:var(--ff-display);font-weight:700;\n  font-size:30px;line-height:1.05;color:var(--color-danger);\n  letter-spacing:-0.025em;\n}\n.tb-highlight .note{\n  font-family:var(--ff-body);font-size:14px;line-height:20px;color:var(--color-ink);\n}\n\n/* Save-callout (FHL desktop) — light blue pill under monthly payment */\n.tb-save-pill{\n  display:inline-flex;align-items:center;\n  height:22px;padding:0 8px;\n  border-radius:9999px;\n  background:#E5F7FF;\n  border:1px solid var(--color-info);\n  color:var(--color-ink);\n  font-family:var(--ff-body);font-weight:500;\n  font-size:13px;line-height:1;\n  margin-top:6px;\n}\n.tb-save-pill b{font-weight:700;margin-right:2px}\n\n/* Bullet list (FHI) — green check / red X rows */\n.tb-bullets{\n  display:flex;flex-direction:column;gap:6px;\n  align-items:flex-start;\n  text-align:left;\n  width:100%;\n  padding:4px 0;\n}\n.tb-bullets .h{\n  font-family:var(--ff-display);font-weight:700;\n  font-size:15px;line-height:20px;color:var(--color-ink);\n  margin-bottom:2px;\n}\n.tb-bullets ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:4px}\n.tb-bullets li{\n  display:flex;align-items:center;gap:6px;\n  font-size:14px;line-height:20px;color:var(--color-ink);\n}\n.tb-bullets li svg{flex:none;width:16px;height:16px}\n.tb-bullets .more{\n  color:var(--color-brand);\n  font-size:14px;line-height:20px;\n  text-decoration:underline;\n  font-weight:500;\n  margin-top:2px;\n  cursor:pointer;\n}\n\n/* ---------- MOBILE CARD ---------- */\n.tbl-card{\n  width:358px;\n  background:#fff;\n  border:1px solid var(--color-paper-3);\n  border-radius:12px;\n  display:flex;flex-direction:column;\n  font-family:var(--ff-body);\n  color:var(--color-ink);\n  overflow:hidden;\n  box-sizing:border-box;\n}\n.tbl-card .top{padding:16px 16px 0;display:flex;flex-direction:column;gap:8px}\n.tbl-card .top-row{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}\n.tbl-card .logo{height:36px;max-width:120px;display:flex;align-items:center}\n.tbl-card .logo img{max-width:100%;max-height:100%}\n.tbl-card .name{font-family:var(--ff-body);font-weight:500;font-size:16px;line-height:22px;color:var(--color-ink)}\n.tbl-card .name-sub{font-size:13px;line-height:18px;color:var(--color-ink-soft);font-family:var(--ff-mono)}\n.tbl-card .price-block{\n  margin:12px 16px 0;\n  border:1px solid var(--color-paper-3);\n  border-radius:12px;\n  padding:14px;\n  text-align:center;\n}\n.tbl-card .price-block .big{\n  font-family:var(--ff-display);font-weight:800;font-size:28px;line-height:1;color:var(--color-ink);\n  letter-spacing:-0.02em;\n}\n.tbl-card .price-block .strike{text-decoration:line-through;color:var(--color-ink-soft);font-weight:500;font-size:16px;margin-right:6px}\n.tbl-card .price-block .red{color:var(--color-danger)}\n.tbl-card .price-block .sub{margin-top:4px;font-size:13px;color:var(--color-ink-muted)}\n.tbl-card .mid-cells{\n  display:grid;grid-template-columns:1fr 1fr;gap:1px;\n  background:var(--color-paper-3);\n  margin:12px 0 0;\n  border-top:1px solid var(--color-paper-3);\n  border-bottom:1px solid var(--color-paper-3);\n}\n.tbl-card .mid-cells .c{\n  background:#fff;padding:10px 14px;display:flex;flex-direction:column;gap:2px;\n}\n.tbl-card .mid-cells .c .label{font-size:12px;color:var(--color-ink-soft)}\n.tbl-card .mid-cells .c .v{font-family:var(--ff-display);font-weight:700;font-size:16px;color:var(--color-ink)}\n.tbl-card .offer{\n  margin:12px 16px;\n  background:#E5FFED;\n  border:1px solid var(--color-success);\n  border-radius:12px;\n  padding:8px 12px;\n  display:flex;align-items:flex-start;gap:8px;\n}\n.tbl-card .offer p{margin:0;font-size:13px;line-height:18px;color:var(--color-ink-muted)}\n.tbl-card .offer p b{color:var(--color-ink);font-weight:700}\n.tbl-card .footer-cta{\n  padding:0 16px 12px;display:flex;flex-direction:column;gap:8px;\n}\n.tbl-card .footer-cta .tb-btn.primary{height:48px;font-size:16px;border-radius:12px}\n.tbl-card .footer-cta .row{display:flex;gap:8px}\n.tbl-card .footer-cta .row .tb-btn{flex:1;justify-content:center}\n\n<\u002Fstyle>\n<style>@font-face {\n  font-family: \"Phosphor\";\n  src:\n    url(\"cc344677-c3c0-4063-a983-2975ff7e93a7\") format(\"woff2\"),\n    url(\"bf7fe06c-dd1f-4282-8afd-14b94ead1ba1\") format(\"woff\"),\n    url(\"5eb57376-306f-4099-b668-7aaed30a9b0b\") format(\"truetype\"),\n    url(\"1d56200f-c082-4399-8810-7427bd588baf#Phosphor\") format(\"svg\");\n  font-weight: normal;\n  font-style: normal;\n  font-display: block;\n}\n\n.ph {\n  /* use !important to prevent issues with browser extensions that change fonts */\n  font-family: \"Phosphor\" !important;\n  speak: never;\n  font-style: normal;\n  font-weight: normal;\n  font-variant: normal;\n  text-transform: none;\n  line-height: 1;\n\n  /* Enable Ligatures ================ */\n  letter-spacing: 0;\n  -webkit-font-feature-settings: \"liga\";\n  -moz-font-feature-settings: \"liga=1\";\n  -moz-font-feature-settings: \"liga\";\n  -ms-font-feature-settings: \"liga\" 1;\n  font-feature-settings: \"liga\";\n  -webkit-font-variant-ligatures: discretionary-ligatures;\n  font-variant-ligatures: discretionary-ligatures;\n\n  /* Better Font Rendering =========== */\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\n.ph.ph-acorn:before {\n  content: \"\\eb9a\";\n}\n.ph.ph-address-book:before {\n  content: \"\\e6f8\";\n}\n.ph.ph-address-book-tabs:before {\n  content: \"\\ee4e\";\n}\n.ph.ph-air-traffic-control:before {\n  content: \"\\ecd8\";\n}\n.ph.ph-airplane:before {\n  content: \"\\e002\";\n}\n.ph.ph-airplane-in-flight:before {\n  content: \"\\e4fe\";\n}\n.ph.ph-airplane-landing:before {\n  content: \"\\e502\";\n}\n.ph.ph-airplane-takeoff:before {\n  content: \"\\e504\";\n}\n.ph.ph-airplane-taxiing:before {\n  content: \"\\e500\";\n}\n.ph.ph-airplane-tilt:before {\n  content: \"\\e5d6\";\n}\n.ph.ph-airplay:before {\n  content: \"\\e004\";\n}\n.ph.ph-alarm:before {\n  content: \"\\e006\";\n}\n.ph.ph-alien:before {\n  content: \"\\e8a6\";\n}\n.ph.ph-align-bottom:before {\n  content: \"\\e506\";\n}\n.ph.ph-align-bottom-simple:before {\n  content: \"\\eb0c\";\n}\n.ph.ph-align-center-horizontal:before {\n  content: \"\\e50a\";\n}\n.ph.ph-align-center-horizontal-simple:before {\n  content: \"